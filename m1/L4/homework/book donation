```html
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>School Club Registration Form</title>
  </head>
  <body>

    <h1>🎨 School Club Registration Form</h1>
    <p>Fill in the form below to join a school club!</p>
    <hr>

    <form>

      <fieldset>
        <legend>Student Details</legend>

        <label>Your Name</label><br>
        <input type="text" id="name" placeholder="Enter your full name"><br><br>

        <label>Student ID</label><br>
        <input type="password" id="student-id" placeholder="Enter your student ID"><br><br>

        <label>Registration Date</label><br>
        <input type="date" id="registration-date"><br>

      </fieldset>

      <br>

      <fieldset>
        <legend>Club Details</legend>

        <label>Choose Club Category</label><br>
        <select id="category">
          <option value="">-- Select a club --</option>
          <option value="art">Art</option>
          <option value="science">Science</option>
          <option value="sports">Sports</option>
          <option value="music">Music</option>
        </select><br><br>

        <label>Experience Level</label><br>
        <input type="radio" name="experience" value="beginner"> Beginner<br>
        <input type="radio" name="experience" value="intermediate"> Intermediate<br>
        <input type="radio" name="experience" value="advanced"> Advanced<br><br>

        <label>Club Interests or Additional Notes</label><br>
        <textarea id="notes" rows="3" cols="35" placeholder="e.g. Your interests, skills, or any notes."></textarea><br>

      </fieldset>

      <br>

      <fieldset>
        <legend>Preferred Club Day</legend>

        <input type="checkbox" value="mon"> Monday<br>
        <input type="checkbox" value="wed"> Wednesday<br>
        <input type="checkbox" value="fri"> Friday<br>

      </fieldset>

      <br>
      <input type="submit" value="Join Club">

    </form>

  </body>
</html>

